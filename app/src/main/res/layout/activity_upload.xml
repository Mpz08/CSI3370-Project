<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Post a Video"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="24dp"
            android:layout_gravity="center_horizontal"/>

        <EditText
            android:id="@+id/etVideoTitle"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Recipe / Video Title"
            android:background="#F0F0F0"
            android:padding="12dp"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/etVideoDescription"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="Description, ingredients, or steps..."
            android:background="#F0F0F0"
            android:padding="12dp"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnSelectVideo"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:text="Tap to Select Video from Gallery"
            android:textSize="16sp"
            android:textColor="#888888"
            android:backgroundTint="#E0E0E0"
            android:layout_marginBottom="32dp"/>

        <Button
            android:id="@+id/btnPostVideo"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Post to PlateMate"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="#FF5722"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="#EEEEEE"
        android:elevation="8dp">

        <Button
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Home"
            style="?android:attr/borderlessButtonStyle"
            android:textColor="#333333"/>

        <Button
            android:id="@+id/navTrending"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Trending"
            style="?android:attr/borderlessButtonStyle"
            android:textColor="#333333"/>

        <Button
            android:id="@+id/navUpload"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Upload"
            style="?android:attr/borderlessButtonStyle"
            android:textColor="#333333"/>

        <Button
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Profile"
            style="?android:attr/borderlessButtonStyle"
            android:textColor="#333333"/>
    </LinearLayout>

</LinearLayout>